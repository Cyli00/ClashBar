{
  "name": "clashbar-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "tauri": "tauri"
  },
  "dependencies": { "@tauri-apps/api": "^2.8.0" },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.8.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
